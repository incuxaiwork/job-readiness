// Prisma Schema for ReadySetJob AI Job Readiness Platform
// Database: PostgreSQL (Railway)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// 1. users — Stores authentication and user roles
model User {
  id           String    @id @db.VarChar(64)
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  role         String    @db.VarChar(32)
  name         String    @db.VarChar(255)
  status       String?   @default("active") @db.VarChar(32)
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  candidateProfiles  CandidateProfile[]
  createdAssessments Assessment[]       @relation("AssessmentCreator")
  createdQuestions   Question[]         @relation("QuestionCreator")
  interviewSessions  InterviewSession[]

  @@map("users")
}

// 2. candidate_profiles — Stores candidate information
model CandidateProfile {
  id                   String    @id @db.VarChar(64)
  userId               String    @map("user_id") @db.VarChar(64)
  name                 String    @db.VarChar(255)
  email                String?   @unique @db.VarChar(255)
  mobile               String?   @db.VarChar(20)
  college              String?   @db.VarChar(255)
  degree               String?   @db.VarChar(128)
  branch               String?   @db.VarChar(128)
  specialization       String?   @db.VarChar(128)
  country              String?   @default("India") @db.VarChar(128)
  state                String?   @db.VarChar(128)
  city                 String?   @db.VarChar(128)
  graduationYear       Int?      @map("graduation_year")
  experienceLevel      String?   @map("experience_level") @db.VarChar(64)
  tenthSchool          String?   @map("tenth_school") @db.VarChar(255)
  tenthMarks           Decimal?  @map("tenth_marks") @db.Decimal(5, 2)
  twelfthCollege       String?   @map("twelfth_college") @db.VarChar(255)
  twelfthDiplomaMarks  Decimal?  @map("twelfth_diploma_marks") @db.Decimal(5, 2)
  graduationPercentage Decimal?  @map("graduation_percentage") @db.Decimal(5, 2)
  cgpa                 Decimal?  @map("cgpa") @db.Decimal(4, 2)
  backlogs             Int?      @default(0) @map("backlogs")
  resumeUrl            String?   @map("resume_url") @db.Text
  createdAt            DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  testAttempts     TestAttempt[]
  skillPerformance SkillPerformance[]
  companyReadiness CompanyReadiness[]
  reports          Report[]

  @@map("candidate_profiles")
}

// Legacy Candidates Table (Compatibility)
model Candidate {
  id                   String    @id @db.VarChar(64)
  experienceLevel      String?   @default("Fresher") @map("experience_level") @db.VarChar(64)
  jobReadinessScore    Int?      @default(0) @map("job_readiness_score")
  readinessStatus      String?   @default("In Progress") @map("readiness_status") @db.VarChar(64)
  aptitudeScore        Int?      @default(0) @map("aptitude_score")
  reasoningScore       Int?      @default(0) @map("reasoning_score")
  technicalScore       Int?      @default(0) @map("technical_score")
  verbalScore          Int?      @default(0) @map("verbal_score")
  codingScore          Int?      @default(0) @map("coding_score")
  assessmentsCompleted Int?      @default(0) @map("assessments_completed")
  tenthMarks           Decimal?  @map("tenth_marks") @db.Decimal(5, 2)
  twelfthDiplomaMarks  Decimal?  @map("twelfth_diploma_marks") @db.Decimal(5, 2)
  graduationPercentage Decimal?  @map("graduation_percentage") @db.Decimal(5, 2)
  backlogs             Int?      @default(0) @map("backlogs")
  createdAt            DateTime? @default(now()) @map("created_at") @db.Timestamptz

  @@map("candidates")
}

// 3. assessments — Stores assessments created by admin
model Assessment {
  id              String    @id @db.VarChar(64)
  title           String    @db.VarChar(255)
  description     String?   @db.Text
  category        String    @db.VarChar(64)
  difficulty      String?   @default("Medium") @db.VarChar(32)
  durationMinutes Int       @map("duration_minutes")
  totalQuestions  Int       @map("total_questions")
  totalMarks      Int       @map("total_marks")
  passingScore    Int       @map("passing_score")
  status          String?   @default("Draft") @db.VarChar(32)
  createdBy       String?   @map("created_by") @db.VarChar(64)
  createdAt       DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  creator      User?                @relation("AssessmentCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  sections     AssessmentSection[]
  questions    AssessmentQuestion[]
  testAttempts TestAttempt[]

  @@map("assessments")
}

// 4. assessment_sections — Stores sections inside an assessment
model AssessmentSection {
  id               String    @id @db.VarChar(64)
  assessmentId     String    @map("assessment_id") @db.VarChar(64)
  name             String    @db.VarChar(128)
  description      String?   @db.Text
  questionCount    Int       @map("question_count")
  marksPerQuestion Int?      @default(1) @map("marks_per_question")
  displayOrder     Int       @map("display_order")
  createdAt        DateTime? @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  assessment Assessment           @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  questions  AssessmentQuestion[]

  @@map("assessment_sections")
}

// 5. assessment_questions — Links assessments and questions with question metadata and marks
model AssessmentQuestion {
  id               String    @id @db.VarChar(64)
  assessmentId     String    @map("assessment_id") @db.VarChar(64)
  questionId       String    @map("question_id") @db.VarChar(64)
  sectionId        String?   @map("section_id") @db.VarChar(64)
  category         String?   @db.VarChar(64)
  topic            String?   @db.VarChar(255)
  question         String?   @db.Text
  difficulty       String?   @db.VarChar(32)
  options          Json?     @db.JsonB
  correctAnswer    String?   @map("correct_answer") @db.VarChar(16)
  marks            Int?      @default(1)
  constraints      Json?
  starterTemplates Json?     @map("starter_templates")
  testCases        Json?     @map("test_cases")
  createdAt        DateTime? @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  assessment  Assessment         @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  questionRef Question           @relation(fields: [questionId], references: [id], onDelete: Cascade)
  section     AssessmentSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  @@unique([assessmentId, questionId])
  @@map("assessment_questions")
}

// 6. skills — Stores skills evaluated by the platform
model Skill {
  id          String    @id @db.VarChar(64)
  name        String    @unique @db.VarChar(128)
  category    String    @db.VarChar(64)
  description String?   @db.Text
  status      String?   @default("active") @db.VarChar(32)
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  questionSkills        QuestionSkill[]
  skillPerformances     SkillPerformance[]
  roleSkillRequirements RoleSkillRequirement[]

  @@map("skills")
}

// 6.5. topics — Topics categorizing questions
model Topic {
  id          String     @id @db.VarChar(64)
  name        String     @db.VarChar(128)
  category    String?    @db.VarChar(64)
  description String?    @db.Text
  status      String?    @default("active") @db.VarChar(32)
  createdAt   DateTime?  @default(now()) @map("created_at") @db.Timestamptz
  questions   Question[]

  @@map("topics")
}

// 7. questions — Main Question Bank
model Question {
  id               String    @id @db.VarChar(64)
  topicId          String?   @map("topic_id") @db.VarChar(64)
  topic            String?   @db.VarChar(255)
  category         String    @db.VarChar(64)
  difficulty       String    @db.VarChar(32)
  type             String    @db.VarChar(64)
  question         String    @db.Text
  codeSnippet      String?   @map("code_snippet") @db.Text
  language         String?   @db.VarChar(32)
  explanation      String?   @db.Text
  marks            Int?      @default(1)
  timeLimitSec     Int?      @default(60) @map("time_limit_sec")
  status           String?   @default("Active") @db.VarChar(32)
  source           String?   @default("Manual") @db.VarChar(32)
  createdBy        String?   @map("created_by") @db.VarChar(64)
  optionsJson      Json?     @map("options")
  correctAnswer    String?   @map("correct_answer") @db.VarChar(16)
  tags             String[]
  constraints      Json?
  starterTemplates Json?     @map("starter_templates")
  testCases        Json?     @map("test_cases")
  createdAt        DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  topicRef            Topic?               @relation(fields: [topicId], references: [id], onDelete: SetNull)
  creator             User?                @relation("QuestionCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  options             QuestionOption[]
  questionSkills      QuestionSkill[]
  assessmentQuestions AssessmentQuestion[]
  candidateAnswers    CandidateAnswer[]

  @@map("questions")
}

// 8. question_options — Stores MCQ options separately
model QuestionOption {
  id           String   @id @db.VarChar(64)
  questionId   String   @map("question_id") @db.VarChar(64)
  optionKey    String   @map("option_key") @db.VarChar(8)
  optionText   String   @map("option_text") @db.Text
  displayOrder Int      @map("display_order")
  isCorrect    Boolean? @default(false) @map("is_correct")

  // Relations
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("question_options")
}

// 9. question_skills — Maps questions to skills
model QuestionSkill {
  id         String   @id @db.VarChar(64)
  questionId String   @map("question_id") @db.VarChar(64)
  skillId    String   @map("skill_id") @db.VarChar(64)
  weight     Decimal? @default(1.0) @db.Decimal

  // Relations
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  skill    Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([questionId, skillId])
  @@map("question_skills")
}

// 11. test_attempts — Stores every candidate's attempt
model TestAttempt {
  id               String    @id @db.VarChar(64)
  candidateId      String    @map("candidate_id") @db.VarChar(64)
  assessmentId     String    @map("assessment_id") @db.VarChar(64)
  attemptNumber    Int       @map("attempt_number")
  status           String?   @default("InProgress") @db.VarChar(32)
  startedAt        DateTime  @default(now()) @map("started_at") @db.Timestamptz
  submittedAt      DateTime? @map("submitted_at") @db.Timestamptz
  timeTakenSeconds Int?      @map("time_taken_seconds")
  createdAt        DateTime? @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  candidate        CandidateProfile     @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  assessment       Assessment           @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  answers          CandidateAnswer[]
  performance      PerformanceAnalysis?
  skillPerformance SkillPerformance[]
  companyReadiness CompanyReadiness[]
  reports          Report[]

  @@map("test_attempts")
}

// 12. candidate_answers — Stores individual answers
model CandidateAnswer {
  id               String    @id @db.VarChar(64)
  attemptId        String    @map("attempt_id") @db.VarChar(64)
  questionId       String    @map("question_id") @db.VarChar(64)
  selectedOption   String?   @map("selected_option") @db.VarChar(8)
  isCorrect        Boolean?  @map("is_correct")
  marksObtained    Decimal?  @default(0) @map("marks_obtained") @db.Decimal
  timeTakenSeconds Int?      @map("time_taken_seconds")
  answeredAt       DateTime? @map("answered_at") @db.Timestamptz

  // Relations
  attempt  TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("candidate_answers")
}

// 13. performance_analysis — Stores overall test analysis
model PerformanceAnalysis {
  id              String    @id @db.VarChar(64)
  attemptId       String    @unique @map("attempt_id") @db.VarChar(64)
  overallScore    Decimal   @map("overall_score") @db.Decimal
  accuracy        Decimal   @db.Decimal
  speedScore      Decimal   @map("speed_score") @db.Decimal
  aptitudeScore   Decimal?  @map("aptitude_score") @db.Decimal
  reasoningScore  Decimal?  @map("reasoning_score") @db.Decimal
  technicalScore  Decimal?  @map("technical_score") @db.Decimal
  strengths       Json?
  weaknesses      Json?
  aiSummary       String?   @map("ai_summary") @db.Text
  recommendations Json?
  createdAt       DateTime? @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  attempt TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@map("performance_analysis")
}

// 14. skill_performance — Stores detailed skill-level performance
model SkillPerformance {
  id                 String    @id @db.VarChar(64)
  attemptId          String    @map("attempt_id") @db.VarChar(64)
  candidateId        String    @map("candidate_id") @db.VarChar(64)
  skillId            String    @map("skill_id") @db.VarChar(64)
  score              Decimal   @db.Decimal
  proficiency        String?   @db.VarChar(32)
  questionsAttempted Int?      @default(0) @map("questions_attempted")
  correctAnswers     Int?      @default(0) @map("correct_answers")
  createdAt          DateTime? @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  attempt   TestAttempt      @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  candidate CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  skill     Skill            @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@map("skill_performance")
}

// 15. companies — Stores companies used for readiness analysis
model Company {
  id          String    @id @db.VarChar(64)
  name        String    @unique @db.VarChar(128)
  industry    String?   @db.VarChar(128)
  description String?   @db.Text
  website     String?   @db.Text
  status      String?   @default("Active") @db.VarChar(32)
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  roles            CompanyRole[]
  companyReadiness CompanyReadiness[]

  @@map("companies")
}

// 16. company_roles — Stores roles offered/targeted for each company
model CompanyRole {
  id              String    @id @db.VarChar(64)
  companyId       String    @map("company_id") @db.VarChar(64)
  roleName        String    @map("role_name") @db.VarChar(128)
  description     String?   @db.Text
  experienceLevel String?   @map("experience_level") @db.VarChar(64)
  status          String?   @default("Active") @db.VarChar(32)
  createdAt       DateTime? @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  company               Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  roleSkillRequirements RoleSkillRequirement[]
  companyReadiness      CompanyReadiness[]

  @@map("company_roles")
}

// 17. role_skill_requirements — Defines what skills are required for each company role
model RoleSkillRequirement {
  id            String   @id @db.VarChar(64)
  roleId        String   @map("role_id") @db.VarChar(64)
  skillId       String   @map("skill_id") @db.VarChar(64)
  requiredScore Decimal? @map("required_score") @db.Decimal
  weight        Decimal? @default(1.0) @db.Decimal
  importance    String?  @default("Required") @db.VarChar(32)

  // Relations
  role  CompanyRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  skill Skill       @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([roleId, skillId])
  @@map("role_skill_requirements")
}

// 18. company_readiness — Stores candidate's company/role suitability result
model CompanyReadiness {
  id             String    @id @db.VarChar(64)
  candidateId    String    @map("candidate_id") @db.VarChar(64)
  attemptId      String?   @map("attempt_id") @db.VarChar(64)
  companyId      String    @map("company_id") @db.VarChar(64)
  roleId         String    @map("role_id") @db.VarChar(64)
  readinessScore Decimal   @map("readiness_score") @db.Decimal
  readinessLevel String?   @map("readiness_level") @db.VarChar(32)
  matchedSkills  Json?     @map("matched_skills")
  skillGaps      Json?     @map("skill_gaps")
  aiAnalysis     String?   @map("ai_analysis") @db.Text
  createdAt      DateTime? @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  candidate CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  attempt   TestAttempt?     @relation(fields: [attemptId], references: [id], onDelete: SetNull)
  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role      CompanyRole      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@map("company_readiness")
}

// 19. reports — Stores the final generated candidate report
model Report {
  id              String    @id @db.VarChar(64)
  candidateId     String    @map("candidate_id") @db.VarChar(64)
  attemptId       String?   @map("attempt_id") @db.VarChar(64)
  reportType      String?   @map("report_type") @db.VarChar(64)
  overallScore    Decimal?  @map("overall_score") @db.Decimal
  summary         String?   @db.Text
  strengths       Json?
  weaknesses      Json?
  recommendations Json?
  reportUrl       String?   @map("report_url") @db.Text
  generatedAt     DateTime? @default(now()) @map("generated_at") @db.Timestamptz

  // Relations
  candidate CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  attempt   TestAttempt?     @relation(fields: [attemptId], references: [id], onDelete: SetNull)

  @@map("reports")
}

// 20. submissions — Legacy Submissions Table
model Submission {
  id              String    @id @db.VarChar(64)
  candidateId     String?   @map("candidate_id") @db.VarChar(64)
  assessmentId    String?   @map("assessment_id") @db.VarChar(64)
  score           Int
  accuracy        Int
  correctCount    Int       @default(0) @map("correct_count")
  incorrectCount  Int       @default(0) @map("incorrect_count")
  unansweredCount Int       @default(0) @map("unanswered_count")
  timeTaken       String?   @map("time_taken") @db.VarChar(64)
  categoryScores  Json?     @map("category_scores")
  topicBreakdown  Json?     @map("topic_breakdown")
  answers         Json?
  createdAt       DateTime? @default(now()) @map("created_at") @db.Timestamptz

  @@map("submissions")
}

// 20.5. assessment_submissions — Active candidate assessment submissions
model AssessmentSubmission {
  id                   String    @id @db.VarChar(64)
  candidateId          String?   @map("candidate_id") @db.VarChar(64)
  candidateName        String?   @map("candidate_name") @db.VarChar(255)
  candidateEmail       String?   @map("candidate_email") @db.VarChar(255)
  assessmentId         String?   @map("assessment_id") @db.VarChar(64)
  assessmentTitle      String?   @map("assessment_title") @db.VarChar(255)
  score                Int
  accuracy             Int
  correctCount         Int       @default(0) @map("correct_count")
  incorrectCount       Int       @default(0) @map("incorrect_count")
  unansweredCount      Int       @default(0) @map("unanswered_count")
  timeTaken            String?   @map("time_taken") @db.VarChar(64)
  categoryScores       Json?     @map("category_scores")
  topicBreakdown       Json?     @map("topic_breakdown")
  answers              Json?
  status               String?   @default("Completed") @db.VarChar(32)
  proctoringViolations Int?      @default(0) @map("proctoring_violations")
  autoSubmitted        Boolean?  @default(false) @map("auto_submitted")
  autoSubmitReason     String?   @map("auto_submit_reason") @db.VarChar(128)
  createdAt            DateTime? @default(now()) @map("created_at") @db.Timestamptz

  @@unique([candidateId, assessmentId])
  @@index([candidateId])
  @@index([candidateId, assessmentId])
  @@map("assessment_submissions")
}

// 20.6. proctoring_events — Proctoring violation logs during assessments
model ProctoringEvent {
  id           String    @id @db.VarChar(64)
  attemptId    String    @map("attempt_id") @db.VarChar(128)
  candidateId  String?   @map("candidate_id") @db.VarChar(64)
  assessmentId String?   @map("assessment_id") @db.VarChar(64)
  type         String    @db.VarChar(64)
  timestamp    DateTime? @default(now()) @db.Timestamptz
  details      Json?

  @@index([attemptId])
  @@index([candidateId])
  @@index([assessmentId])
  @@map("proctoring_events")
}

// 21. company_eligibility_criteria — Criteria and cutoffs for company job roles
model CompanyEligibilityCriteria {
  id                       String    @id @db.VarChar(64)
  company                  String    @db.VarChar(128)
  role                     String    @db.VarChar(128)
  tenthPercentage          Decimal?  @default(60.00) @map("tenth_percentage") @db.Decimal(5, 2)
  twelfthDiplomaPercentage Decimal?  @default(60.00) @map("twelfth_diploma_percentage") @db.Decimal(5, 2)
  graduationPercentage     Decimal?  @default(60.00) @map("graduation_percentage") @db.Decimal(5, 2)
  maxBacklogs              Int?      @default(0) @map("max_backlogs")
  aptitudeCutoff           Int?      @default(60) @map("aptitude_cutoff")
  reasoningCutoff          Int?      @default(60) @map("reasoning_cutoff")
  verbalCutoff             Int?      @default(60) @map("verbal_cutoff")
  technicalCutoff          Int?      @default(60) @map("technical_cutoff")
  codingCutoff             Int?      @default(50) @map("coding_cutoff")
  overallReadinessCutoff   Int?      @default(60) @map("overall_readiness_cutoff")
  createdAt                DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([company, role], map: "uq_company_role")
  @@map("company_eligibility_criteria")
}

// ==========================================================
// AI MOCK INTERVIEW & TELEMETRY MODELS
// ==========================================================

// 22. interview_sessions — Stores AI mock interview sessions
model InterviewSession {
  id                 String    @id @db.VarChar(64)
  userId             String?   @map("user_id") @db.VarChar(64)
  status             String    @default("IN_PROGRESS") @db.VarChar(32)
  targetRole         String?   @default("Software Engineer") @map("target_role") @db.VarChar(128)
  startedAt          DateTime  @default(now()) @map("started_at") @db.Timestamptz
  completedAt        DateTime? @map("completed_at") @db.Timestamptz
  duration           Int?      @default(0)
  overallScore       Decimal?  @map("overall_score") @db.Decimal(5, 2)
  interviewScore     Decimal?  @map("interview_score") @db.Decimal(5, 2)
  communicationScore Decimal?  @map("communication_score") @db.Decimal(5, 2)
  confidenceScore    Decimal?  @map("confidence_score") @db.Decimal(5, 2)
  eyeContactScore    Decimal?  @map("eye_contact_score") @db.Decimal(5, 2)
  attentionScore     Decimal?  @map("attention_score") @db.Decimal(5, 2)
  technicalScore     Decimal?  @map("technical_score") @db.Decimal(5, 2)
  expressionScore    Decimal?  @map("expression_score") @db.Decimal(5, 2)
  speechScore        Decimal?  @map("speech_score") @db.Decimal(5, 2)
  createdAt          DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  user      User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions InterviewQuestion[]
  telemetry InterviewTelemetry[]
  analysis  InterviewAnalysis?

  @@index([userId])
  @@index([status])
  @@map("interview_sessions")
}

// 23. interview_questions — Questions within an interview session
model InterviewQuestion {
  id             String    @id @db.VarChar(64)
  sessionId      String    @map("session_id") @db.VarChar(64)
  questionNumber Int       @map("question_number")
  questionText   String    @map("question_text") @db.Text
  category       String    @default("TECHNICAL") @db.VarChar(64)
  askedAt        DateTime  @default(now()) @map("asked_at") @db.Timestamptz
  completedAt    DateTime? @map("completed_at") @db.Timestamptz

  // Relations
  session   InterviewSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  answers   InterviewAnswer[]
  telemetry InterviewTelemetry[]

  @@unique([sessionId, questionNumber])
  @@index([sessionId])
  @@map("interview_questions")
}

// 24. interview_answers — Candidate answers per question
model InterviewAnswer {
  id                 String    @id @db.VarChar(64)
  questionId         String    @map("question_id") @db.VarChar(64)
  transcript         String    @db.Text
  startedAt          DateTime  @default(now()) @map("started_at") @db.Timestamptz
  completedAt        DateTime? @map("completed_at") @db.Timestamptz
  duration           Int?      @default(0)
  overallScore       Decimal?  @map("overall_score") @db.Decimal(5, 2)
  communicationScore Decimal?  @map("communication_score") @db.Decimal(5, 2)
  technicalScore     Decimal?  @map("technical_score") @db.Decimal(5, 2)
  confidenceScore    Decimal?  @map("confidence_score") @db.Decimal(5, 2)
  eyeContactScore    Decimal?  @map("eye_contact_score") @db.Decimal(5, 2)
  attentionScore     Decimal?  @map("attention_score") @db.Decimal(5, 2)
  relevanceScore     Decimal?  @map("relevance_score") @db.Decimal(5, 2)
  dominantEmotion    String?   @map("dominant_emotion") @db.VarChar(64)
  speechRate         Decimal?  @map("speech_rate") @db.Decimal(5, 2)
  answerQuality      String?   @map("answer_quality") @db.VarChar(64)
  aiFeedback         String?   @map("ai_feedback") @db.Text
  createdAt          DateTime? @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  question InterviewQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("interview_answers")
}

// 25. interview_telemetry — Real-time telemetry samples aggregated during interview
model InterviewTelemetry {
  id                  String   @id @db.VarChar(64)
  sessionId           String   @map("session_id") @db.VarChar(64)
  questionId          String?  @map("question_id") @db.VarChar(64)
  timestamp           DateTime @default(now()) @db.Timestamptz
  faceDetected        Boolean  @default(true) @map("face_detected")
  eyeContact          Decimal  @default(0) @map("eye_contact") @db.Decimal(5, 2)
  gazeDirection       String?  @map("gaze_direction") @db.VarChar(64)
  blinkRate           Decimal? @map("blink_rate") @db.Decimal(5, 2)
  emotion             String   @default("Neutral") @db.VarChar(64)
  emotionConfidence   Decimal? @map("emotion_confidence") @db.Decimal(5, 2)
  attention           Decimal  @default(0) @db.Decimal(5, 2)
  confidence          Decimal  @default(0) @db.Decimal(5, 2)
  pitch               Decimal? @db.Decimal(5, 2)
  yaw                 Decimal? @db.Decimal(5, 2)
  roll                Decimal? @db.Decimal(5, 2)
  speechRate          Decimal? @map("speech_rate") @db.Decimal(5, 2)
  lipSync             Decimal? @map("lip_sync") @db.Decimal(5, 2)
  expressionStability Decimal? @map("expression_stability") @db.Decimal(5, 2)

  // Relations
  session  InterviewSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question InterviewQuestion? @relation(fields: [questionId], references: [id], onDelete: SetNull)

  @@index([sessionId])
  @@index([questionId])
  @@index([timestamp])
  @@index([sessionId, timestamp])
  @@index([questionId, timestamp])
  @@map("interview_telemetry")
}

// 26. interview_analysis — Final consolidated interview evaluation & question breakdown
model InterviewAnalysis {
  id                 String    @id @db.VarChar(64)
  sessionId          String    @unique @map("session_id") @db.VarChar(64)
  overallScore       Decimal   @map("overall_score") @db.Decimal(5, 2)
  communicationScore Decimal   @map("communication_score") @db.Decimal(5, 2)
  confidenceScore    Decimal   @map("confidence_score") @db.Decimal(5, 2)
  eyeContactScore    Decimal   @map("eye_contact_score") @db.Decimal(5, 2)
  attentionScore     Decimal   @map("attention_score") @db.Decimal(5, 2)
  expressionScore    Decimal   @map("expression_score") @db.Decimal(5, 2)
  technicalScore     Decimal   @map("technical_score") @db.Decimal(5, 2)
  speechScore        Decimal   @map("speech_score") @db.Decimal(5, 2)
  blinkRate          Decimal?  @map("blink_rate") @db.Decimal(5, 2)
  dominantEmotion    String?   @map("dominant_emotion") @db.VarChar(64)
  emotionStability   Decimal?  @map("emotion_stability") @db.Decimal(5, 2)
  lipSyncScore       Decimal?  @map("lip_sync_score") @db.Decimal(5, 2)
  strengths          Json?
  weaknesses         Json?
  recommendations    Json?
  aiFeedback         String?   @map("ai_feedback") @db.Text
  questionBreakdown  Json?     @map("question_breakdown")
  createdAt          DateTime? @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  session InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("interview_analysis")
}
