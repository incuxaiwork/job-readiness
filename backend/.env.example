# ==============================================================================
# READYSETJOB BACKEND ENVIRONMENT CONFIGURATION (3K+ CONCURRENT STUDENTS SCALE)
# ==============================================================================

# ---- 1. Database (PostgreSQL Connection Pool) ----
# Required for persisting candidate records, assessments, telemetry, and interview sessions.
# For 3K+ concurrent students, use a pooled connection (e.g. PgBouncer or Supabase/Railway pooler).
# DATABASE_URL         -> internal hostname, used when NODE_ENV=production (Railway VPC)
# DATABASE_PUBLIC_URL  -> public proxy URL, used in development (falls back to DATABASE_URL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/jobrecipe
DATABASE_PUBLIC_URL=postgresql://postgres:password@localhost:5432/jobrecipe
DATABASE_POOL_MAX=50
DATABASE_CONNECTION_TIMEOUT=5000
DATABASE_IDLE_TIMEOUT=10000

# ---- 2. High-Concurrency Queue & Distributed Caching (Redis) ----
# CRITICAL FOR 3K+ STUDENTS: Prevents database locks during peak exam submission bursts.
# Used by Bull queue to process exam submissions smoothly and handle rate-limiting.
# REDIS_URL          -> internal hostname, used when NODE_ENV=production (Railway VPC)
# REDIS_PUBLIC_URL   -> public proxy URL, used in development (falls back to REDIS_URL)
REDIS_URL=redis://localhost:6379
REDIS_PUBLIC_URL=redis://localhost:6379
SUBMISSION_WORKER_CONCURRENCY=20

# ---- 3. Server Configuration ----
PORT=5000
NODE_ENV=production
# REQUIRED on every environment: generate with `openssl rand -base64 48` (never use a real secret here)
JWT_SECRET=
# Comma-separated origins allowed to call the API. Same-origin deploy: omit (or use the app URL).
# Split deploy (frontend served from its own Railway URL): set to the FRONTEND public URL, e.g.
# CORS_ORIGIN=https://jobreadiness-fe.up.railway.app
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Refresh-token cookie policy. Same-origin: 'strict' (or 'lax'). Split deploy (FE and BE on
# different domains): MUST be 'none' so the browser sends the HttpOnly cookie to the API.
REFRESH_COOKIE_SAMESITE=lax
BCRYPT_SALT_ROUNDS=10
ALLOW_ASSESSMENT_RETAKE=false
REQUEST_TIMEOUT_MS=30000

# ---- 4. Online Code Execution Engine (Judge0 / Piston) ----
# Used for compiling & evaluating candidate programming submissions in real-time.
# Free public Judge0: https://ce.judge0.com
# For 3,000 students, subscribe to Judge0 Extra CE via RapidAPI or host your own Judge0/Piston instance.
CODE_EXECUTOR=judge0
JUDGE0_URL=https://ce.judge0.com
JUDGE0_API_KEY=
PISTON_URL=http://localhost:2000
CODE_EXEC_CONCURRENCY=25
GLOBAL_EXEC_CONCURRENCY=100

# ---- 5. HeyGen Interactive Streaming AI Avatar Integration ----
# Used for real-time WebRTC AI Interviewer video and voice interaction.
# Generate API key at: https://app.heygen.com/settings?nav=API (Enterprise/Scale account required)
# Token creation endpoint: POST https://api.heygen.com/v1/streaming.create_token
HEYGEN_API_KEY=
# Default Interactive Avatar ID (e.g. josh_lite3_20230714, ann_doctor_standing_up_20240124, Wayne_20240711)
HEYGEN_AVATAR_ID=josh_lite3_20230714
# Default Voice ID for the avatar
HEYGEN_VOICE_ID=1bd001e7e50f421d837fb814d45444c1
# Allow mock avatar tokens during automated CI / load testing without live HeyGen credit consumption
ALLOW_MOCK_AVATAR=false
