{
  "name": "jobrecipe",
  "version": "1.0.0",
  "description": "Job Readiness + AI Mock Interview platform: one frontend, one backend, one database",
  "private": true,
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix frontend && npm install",
    "install:ai": "pip install -r ai-service/requirements.txt",
    "dev": "concurrently -k -n API,WEB,AI -c green,cyan,yellow \"npm:dev:backend\" \"npm:dev:frontend\" \"npm:dev:ai\"",
    "dev:core": "concurrently -k -n API,WEB -c green,cyan \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:ai": "cd ai-service && python api/app.py",
    "db:migrate": "cd backend && npx prisma migrate deploy",
    "db:generate": "cd backend && npx prisma generate",
    "db:studio": "cd backend && npx prisma studio",
    "seed": "npm run seed --prefix backend",
    "build": "npm run build --prefix frontend",
    "start": "npm run start --prefix backend"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
