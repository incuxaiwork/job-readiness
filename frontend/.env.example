# ==============================================================================
# READYSETJOB FRONTEND ENVIRONMENT CONFIGURATION
# ==============================================================================

# ---- 1. Backend REST API Base URL ----
VITE_API_URL=http://localhost:5000/api

# ---- 2. ElevenLabs Text-to-Speech API Key (Lifelike Voice Interviewer) ----
# Generates realistic, human-sounding speech for the AI Mock Interviewer avatar.
# If left blank, the frontend automatically falls back to browser Web Speech API.
# Get free/pro API key at: https://elevenlabs.io
VITE_ELEVENLABS_API_KEY=
# Voice ID (Default: 'pNInz6obpgDQGcFmaJgB' - Adam / Deep Professional Voice)
VITE_ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
